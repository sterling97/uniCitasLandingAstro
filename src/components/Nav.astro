---
/* FORMATO — no editar para cambios de contenido (textos en content.ts). */
import { content } from '../config/content';
---

<nav style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px clamp(20px,5vw,72px);border-bottom:2px solid var(--color-text)">
  <div style="display:flex;align-items:center;gap:12px">
    <div style="width:20px;height:20px;background:var(--color-accent)"></div>
    <span style="font-family:var(--font-heading);font-weight:800;font-size:17px;letter-spacing:-0.02em">{content.brand.name}</span>
  </div>
  <div style="display:flex;align-items:center;gap:24px">
    {content.nav.links.map((link) => (
      <a href={link.href} style="font-size:13px;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-text)">{link.label}</a>
    ))}
    <a href={content.bookingUrl} class="btn btn-primary">{content.nav.ctaLabel}</a>
  </div>
</nav>
