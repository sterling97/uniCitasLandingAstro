---
/* FORMATO — no editar para cambios de contenido (texto en content.ts). */
import { content } from '../config/content';
---

<section style="padding:70px 0">
  <blockquote style="font-family:var(--font-heading);font-weight:800;font-size:clamp(24px,2.6vw,34px);line-height:1.25;letter-spacing:-0.015em;max-width:32ch;margin:0">{content.quote.text}</blockquote>
  <div style="font-size:15px;color:var(--color-neutral-700);margin-top:28px">{content.quote.author}</div>
</section>
