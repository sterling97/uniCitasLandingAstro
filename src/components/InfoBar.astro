---
/* FORMATO — no editar para cambios de contenido (textos en content.ts). */
import { content } from '../config/content';
---

<section style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;padding:42px 0">
  {content.infoBar.map((item) => (
    <div>
      <div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-neutral-600)">{item.label}</div>
      <div style="font-family:var(--font-heading);font-weight:700;font-size:19px;margin-top:6px">{item.value}</div>
    </div>
  ))}
</section>
